{
  "services": ["auth", "firestore"],
  "auth": {
    "providers": ["password"]
  },
  "should_config_admin": true,
  "firestore": {
    "collections": {
      "branches": {
        "description": "Pickup locations",
        "fields": {
          "name": "string",
          "name_arabic": "string",
          "address": "string",
          "address_arabic": "string",
          "etaMinutes": "number",
          "active": "boolean",
          "sortOrder": "number"
        }
      },
      "menu_categories": {
        "description": "Menu category chips (includes synthetic 'all')",
        "fields": {
          "label": "string",
          "label_arabic": "string",
          "sortOrder": "number"
        }
      },
      "menu_items": {
        "description": "Dishes with bilingual copy and optional modifiers",
        "fields": {
          "name": "string",
          "name_arabic": "string",
          "description": "string",
          "description_arabic": "string",
          "longDescription": "string",
          "longDescription_arabic": "string",
          "featuredSubtitle": "string",
          "featuredSubtitle_arabic": "string",
          "price": "number",
          "categoryId": "string",
          "branchId": "string",
          "image": "string",
          "featured": "boolean",
          "badge": "string",
          "badge_arabic": "string",
          "calories": "number",
          "available": "boolean",
          "sortOrder": "number",
          "modifiers": "array"
        }
      },
      "users": {
        "description": "Extended customer profile (doc id = Auth uid). Email lives in Auth only. Not seeded.",
        "fields": {
          "displayName": "string",
          "contactPhone": "string|null",
          "createdAt": "string",
          "updatedAt": "string"
        },
        "addressFields": {
          "line1": "string",
          "line2": "string",
          "area": "string",
          "city": "string",
          "notes": "string"
        }
      },
      "orders": {
        "description": "Customer pickup orders with embedded line items",
        "fields": {
          "userId": "string",
          "orderCode": "string",
          "status": "string",
          "readyAround": "string",
          "branchId": "string",
          "branchLabel": "string",
          "branchLabel_arabic": "string",
          "address": "string",
          "address_arabic": "string",
          "items": "array",
          "subtotal": "number",
          "vat": "number",
          "total": "number",
          "contact": "map",
          "createdAt": "string",
          "updatedAt": "string"
        },
        "itemFields": {
          "id": "string",
          "menuItemId": "string",
          "name": "string",
          "name_arabic": "string",
          "image": "string",
          "unitPrice": "number",
          "quantity": "number",
          "optionsSummary": "string",
          "optionsSummary_arabic": "string",
          "selectedOptionIds": "array"
        },
        "contactFields": {
          "name": "string",
          "name_arabic": "string",
          "phone": "string"
        },
        "statusValues": [
          "pending",
          "confirmed",
          "preparing",
          "ready",
          "completed",
          "cancelled"
        ]
      }
    }
  }
}
