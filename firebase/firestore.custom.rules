rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function isCreatingAsSelf() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    // ── Public catalog (guest-readable; admin writes) ─────────

    match /branches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menu_categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menu_items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── User profiles (doc id = Auth uid) ─────────────────────
    // Owner read/write; client admin may list profiles for the dashboard.

    match /users/{userId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['updatedAt']);
      allow delete: if false;
    }

    // ── Pickup orders ─────────────────────────────────────────

    match /orders/{orderId} {
      allow create: if isCreatingAsSelf()
        && request.resource.data.keys().hasAll([
          'userId',
          'orderCode',
          'status',
          'items',
          'subtotal',
          'vat',
          'total',
          'contact',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.items is list
        && request.resource.data.subtotal is number
        && request.resource.data.vat is number
        && request.resource.data.total is number;

      // Owner or client admin (dashboard needs all orders, incl. preview).
      allow read: if isOwner() || isAdmin();

      allow update: if isAdmin()
        || (isOwner()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.orderCode == resource.data.orderCode);

      allow delete: if false;
    }
  }
}
