# Firebase Admin — shared by all scripts under scripts/
FIREBASE_PROJECT_ID=restaurent-order-app-local

# Option A (recommended): path to service account JSON
# Download from Firebase Console → Project settings → Service accounts → Generate new private key
# Name by env: local-service-account.json / prod-service-account.json (gitignored: *-service-account.json)
GOOGLE_APPLICATION_CREDENTIALS=./local-service-account.json

# Option B: paste the full service account JSON as a single line (CI-friendly)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional: rewrite seed userId placeholders (REPLACE_WITH_AUTH_UID)
# SEED_USER_ID=

# Optional: override seed file path (default: ../firebase/seed-data.json)
# SEED_DATA_PATH=
