# Nest backend origin (no /api suffix — client appends it)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional — preview welcome overlay on first visit to sign-in
# EXPO_PUBLIC_PREVIEW_MODE=1

# Optional — service enable overrides
# EXPO_PUBLIC_SERVICE_APPLE_LOGIN=1
# EXPO_PUBLIC_SERVICE_GOOGLE_LOGIN=1
# EXPO_PUBLIC_SERVICE_PHONE_LOGIN=1
# EXPO_PUBLIC_SERVICE_CREATE_ACCOUNT_PHONE=1
