# Nest backend origin (no /api suffix — client appends it)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional — preview welcome overlay on first visit to sign-in
# EXPO_PUBLIC_PREVIEW_MODE=1

# Card payments (PaymentSheet / Elements) — publishable key only; secrets stay on backend
# Presence of this key enables stripePayment (cash always available)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Firebase client config (copy from firebase/.env.example)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Required on **native** (iOS/Android) only — Expo OAuth. Web uses Firebase popup alone.
# Firebase already created it: Google Cloud → Credentials → "Web client (auto created by Google Service)"
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Optional — injectable feature flags (see ai_instruction/features/)
# EXPO_PUBLIC_FEATURE_APPLE_AUTH=1
# EXPO_PUBLIC_FEATURE_GOOGLE_AUTH=1
