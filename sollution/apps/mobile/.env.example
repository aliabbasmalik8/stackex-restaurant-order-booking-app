# Nest backend origin (no /api suffix — client appends it)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional — preview welcome overlay on first visit to sign-in
# EXPO_PUBLIC_PREVIEW_MODE=1

# Card payments (PaymentSheet) — publishable key only; secrets stay on backend
# Presence of this key enables card checkout (cash always available)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional — feature enable overrides (see ai_instruction/features/)
# EXPO_PUBLIC_SERVICE_APPLE_LOGIN=1
# EXPO_PUBLIC_SERVICE_GOOGLE_LOGIN=1
# EXPO_PUBLIC_SERVICE_PHONE_LOGIN=1
# EXPO_PUBLIC_SERVICE_CREATE_ACCOUNT_PHONE=1
# EXPO_PUBLIC_SERVICE_NOTIFICATIONS=1
# EXPO_PUBLIC_SERVICE_HELP_SUPPORT=1
