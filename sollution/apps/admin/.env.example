# Nest backend origin (no /api suffix — client appends it)
VITE_API_URL=http://localhost:8000

# When true/1/yes, admin UI blocks closing the store, product image upload,
# and branch delivery-location edit (notice modal).
# VITE_IS_PUBLIC_PREVIEW_MODE=1

# Features (see src/features/_registry + ai_instruction/features)
# Firebase Storage product image upload — also flip registry mode to `enabled`
# and set backend FIREBASE_STORAGE_BUCKET (Blaze plan).
# VITE_FEATURE_FIREBASE_STORAGE=1

# Branch pin map (Maps JavaScript API). Separate key from Nest GOOGLE_MAPS_API_KEY.
# Restrict to HTTP referrers + Maps JavaScript API only (e.g. http://localhost:5173/*).
# Omit → location editor stays lat/lng number fields (no map script).
# VITE_GOOGLE_MAPS_WEB_KEY=
