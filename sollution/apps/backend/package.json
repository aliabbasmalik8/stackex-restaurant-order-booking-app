{
  "name": "backend",
  "version": "0.0.1",
  "description": "Order booking NestJS API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "validate-generate-migration": "if [ -z \"$npm_config_name\" ]; then echo 'Error: Migration file name is required. (i.e --name=firstMigration)' && exit 1; fi",
    "typorm-data-source": "npm run build && npx typeorm -d dist/migrations/data-source.js",
    "generate-migration-file": "npm run validate-generate-migration && npm run typorm-data-source -- migration:generate src/migrations/history/$npm_config_name",
    "migration:run": "npm run typorm-data-source -- migration:run",
    "migration:revert": "npm run typorm-data-source -- migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "typescript": "^5.9.3"
  }
}
