PORT=8000
# App environment: development | staging | production
environment=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/order-booking

JWT_SECRET=change-me-access-secret

# Comma-separated browser origins (no trailing slash). Empty = allow any (dev).
CORS_ORIGINS=http://dineos-live.localhost,https://dineos-live.preview.stackex.ai,http://localhost:3000,http://localhost:8081

# White-label Stripe secrets (per-client deploy). Omit STRIPE_SECRET_KEY to keep cash-only.
# Setup guide: ai_instruction/features/stripe/setup.md
# Currency / business name: settings module (ai_instruction/modules/setting) — not env.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase Admin — verify client ID tokens; Nest still issues JWTs.
# Copy names from firebase/.env.example (server keys only).
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Required for product image upload (firebase-storage module). Blaze plan.
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Google Maps Platform — Geocoding API (server key). Omit to disable reverse geocode (503).
# Restrict this key to your backend IPs. Setup: ai_instruction/features/google-maps/setup.md
# GOOGLE_MAPS_API_KEY=
