# Nest backend origin (no /api suffix — client appends it)
VITE_API_URL=http://localhost:8000

# Optional — preview welcome overlay on first visit to sign-in
# VITE_PREVIEW_MODE=1

# Firebase client config (copy from firebase/.env.example)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Optional — injectable feature flags (see ai_instruction/features/)
# VITE_FEATURE_GOOGLE_AUTH=1
# VITE_FEATURE_APPLE_AUTH=1

# Card payments — publishable key only; secrets stay on backend
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Address pin map (Maps JavaScript API). Separate key from Nest GOOGLE_MAPS_API_KEY.
# Restrict to HTTP referrers + Maps JavaScript API only (e.g. http://localhost:5174/*).
# Omit → add-address still has Places search, no live map.
# VITE_GOOGLE_MAPS_WEB_KEY=
